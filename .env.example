# ==============================================================================
# ZAFF-IT Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to `.env` for local Expo development.
# NEVER commit `.env` or any real secret keys to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC CLIENT VARIABLES (Bundled into Expo React Native App)
#    Only put non-sensitive public keys here. Prefix MUST be EXPO_PUBLIC_.
# ------------------------------------------------------------------------------
EXPO_PUBLIC_ENV=development
EXPO_PUBLIC_APP_NAME=ZAFF-IT
EXPO_PUBLIC_DEFAULT_CITY=Makrana

# Supabase Public Project Settings (Project Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Cloudflare R2 Public CDN Base URL (for public catalogue images only)
EXPO_PUBLIC_MEDIA_BASE_URL=https://media.zaff-it.in

# Razorpay Public Key ID (Use rzp_test_* for Free-Tier Test Mode)
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Feature Flag Defaults (Server-side feature_flags table is authoritative)
EXPO_PUBLIC_ENABLE_ZAFFY_AI=true

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (Set via `npx supabase secrets set`, NEVER in Expo .env)
#    Do NOT prefix these with EXPO_PUBLIC_. They run only inside Edge Functions.
# ------------------------------------------------------------------------------

# Supabase Service Role (Bypasses RLS inside trusted Edge Functions only)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret

# Cloudflare R2 (10 GB Free Tier - S3-Compatible Signed URLs)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=zaff-it-media
R2_PUBLIC_BASE_URL=https://media.zaff-it.in

# Razorpay Server Keys & Webhook Secret (Test Mode first, Live Mode post-KYC)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-hmac-sha256-webhook-secret

# OpenStreetMap Nominatim & OSRM (Free Open-Source Maps & Routing)
# Must provide a descriptive User-Agent per Nominatim Usage Policy
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=ZAFF-IT-Makrana/1.0 (ops@zaffmind.in)
OSRM_BASE_URL=https://router.project-osrm.org

# Google AI Studio / Gemini API Free Tier (Zaffy AI Read-Only Assistant)
GEMINI_API_KEY=your-google-ai-studio-api-key
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 3. CI / EAS BUILD VARIABLES (Used by Expo CLI / GitHub Actions only)
# ------------------------------------------------------------------------------
EAS_PROJECT_ID=your-expo-eas-project-uuid
EXPO_TOKEN=your-expo-ci-access-token
